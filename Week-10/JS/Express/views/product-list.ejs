<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product List</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 font-sans leading-normal tracking-normal">
  <div class="container mx-auto px-4 py-6">
    <h1 class="text-4xl font-extrabold text-center text-gray-800 mb-12">Product List</h1>

     <!-- 🔍 Search Form -->
     <form action="/product-list" method="GET" class="flex justify-center mb-6">
        <input
          type="text"
          name="searchTerm"
          placeholder="Search by title..."
          value="<%= searchTerm %>"
          class="border border-gray-300 rounded-l px-4 py-2 w-1/2 focus:outline-none"
        />
        <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-r hover:bg-blue-700">
          Search
        </button>
      </form>

    <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
      <% products.forEach(product => { %>
        <li class="bg-white rounded-lg shadow-lg overflow-hidden transform hover:scale-105 hover:shadow-xl transition duration-300">
          <!-- Image Section -->
          <div class="w-full h-64 bg-cover bg-center" style="background-image: url('<%= product.image %>');"></div>

          <!-- Product Details -->
          <div class="p-6">
            <h2 class="text-2xl font-semibold text-gray-800 mb-2"><%= product.title %></h2>
            <p class="text-gray-600 mb-4"><%= product.description %></p>
            <p class="text-xl font-bold text-gray-800 mb-4">Price: $<%= product.price %></p>
            <p class="text-sm text-gray-500 mb-4">Category: <%= product.category %></p>

            <!-- Add to Cart Button -->
            <button class="w-full bg-blue-500 text-white py-2 rounded-lg font-semibold text-lg transition duration-300 hover:bg-blue-600 focus:outline-none">
              Add to Cart
            </button>
          </div>
        </li>
      <% }); %>
    </ul>
  </div>

  <!-- Tailwind UI for Modal and Cart functionality (optional) -->
</body>

</html>
